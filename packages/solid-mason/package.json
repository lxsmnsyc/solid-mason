{
  "name": "solid-mason",
  "version": "0.2.0",
  "private": false,
  "description": "Masonry layout for SolidJS",
  "keywords": [
    "grid",
    "layout",
    "masonry",
    "solid",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-mason/tree/main/packages/solid-mason",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-mason/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-mason.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.47",
    "@solidjs/web": "^2.0.0-rc.13",
    "@types/node": "^26.5.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.63.0",
    "solid-js": "^2.0.0-rc.13",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.13"
  },
  "engines": {
    "node": ">=20"
  }
}
