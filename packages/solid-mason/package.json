{
  "name": "solid-mason",
  "version": "0.1.7",
  "private": false,
  "description": "Masonry layout for SolidJS",
  "keywords": [
    "grid",
    "layout",
    "masonry",
    "solid",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-mason/tree/main/packages/solid-mason",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-mason/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-mason.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "solid-use": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.63.0",
    "solid-js": "^1.9.15",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
